+
+/* A4 preview: photo space grows with the page, text remains readable. */
+.report-page { aspect-ratio: 210 / 297; display: flex; flex-direction: column; padding: 4%; min-width: 0; }
+.report-page > :last-child { margin-top: auto; padding-top: 12px; }
+.report-photo-layout { flex: 1; min-height: 260px; display: grid; gap: 12px; grid-template-columns: repeat(6, minmax(0, 1fr)); align-content: stretch; }
+.report-photo { margin: 0; min-width: 0; min-height: 0; display: flex; flex-direction: column; grid-column: span 3; }
+.report-photo-layout--1 .report-photo, .report-photo-layout--2 .report-photo { grid-column: span 6; }
+.report-photo-layout--3 .report-photo:first-child { grid-column: span 6; }
+.report-photo-layout--5 .report-photo:nth-child(n+3), .report-photo-layout--6 .report-photo { grid-column: span 2; }
+.report-photo-frame { flex: 1; min-height: 80px; display: flex; align-items: center; justify-content: center; background: #f8fafc; border: 1px solid #e2e8f0; }
+.report-photo-frame img { display: block; width: 100%; height: 100%; max-height: 310px; object-fit: contain; }
+.report-photo-layout--2 img, .report-photo-layout--3 img, .report-photo-layout--4 img { max-height: 180px; }
+.report-photo-layout--5 img, .report-photo-layout--6 img, .report-photo-layout--7 img { max-height: 145px; }
+.report-photo-subtitle { text-align: center; font-weight: 700; margin-bottom: 4px; overflow-wrap: anywhere; }
+.report-photo figcaption { font-size: 9px; text-align: center; margin-top: 4px; overflow-wrap: anywhere; }
+.report-empty { min-height: 180px; display: grid; place-items: center; color: #64748b; border: 1px dashed #cbd5e1; }
